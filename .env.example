# CACS Configuration Template
# Copy this file to .env and update with your actual values

# Project paths - UPDATE THESE TO MATCH YOUR SYSTEM
PROJECT_ROOT=/path/to/your/cacs-hitl
SUBAGENTS_DIR=/path/to/your/cacs-hitl/SUBAGENTS
PROJECT_NAME=CACS-Test

# Database (SQLite for testing)
DATABASE_ENGINE=sqlite3
DATABASE_NAME=db.sqlite3

# Django
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Zellij
ZELLIJ_BINARY=zellij

# File Watcher
WATCHER_POLL_INTERVAL=2.0

# Rate Limiting
DEFAULT_BATCH_SIZE=3
DEFAULT_DELAY_SECONDS=5.0
