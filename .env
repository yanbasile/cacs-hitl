# CACS Configuration

# Project paths
PROJECT_ROOT=/home/user/cacs-hitl
SUBAGENTS_DIR=/home/user/cacs-hitl/SUBAGENTS
PROJECT_NAME=CACS-Test

# Database (SQLite for testing)
DATABASE_ENGINE=sqlite3
DATABASE_NAME=db.sqlite3

# Django
SECRET_KEY=test-secret-key-for-cacs-development-only-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Zellij
ZELLIJ_BINARY=zellij

# File Watcher
WATCHER_POLL_INTERVAL=2.0

# Rate Limiting
DEFAULT_BATCH_SIZE=3
DEFAULT_DELAY_SECONDS=5.0
